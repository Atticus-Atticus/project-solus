; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Solus"
run/main_scene="res://Scenes/User Interface/Menus/MainMenuStartUp.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
boot_splash/image="res://Scenes/User Interface/Menus/Project Solus Splash Screen 3.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
config/icon="res://Scenes/User Interface/Menus/Project Solus Icon 500x500.png"
config/windows_native_icon="res://Project Solus Icon.ico"
run/size/borderless=false

[audio]

buses/default_bus_layout="res://Audio/default_bus_layout.tres"

[autoload]

Globals="*res://Scripts/GlobalScripts/globals.gd"
SceneSwitcher="*res://Scripts/GlobalScripts/SceneSwitcher.gd"
RecTime="*res://addons/stopwatch/Stopwatch.gd"
VolumeControlScript="*res://Scripts/VolumeControlScript.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="viewport"

[global_group]

"Security Cams"=""
Supplies=""
Player=""

